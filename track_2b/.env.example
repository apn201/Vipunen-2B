# Copy to .env and fill in. .env is gitignored and dockerignored.
# Names follow the HackApertus template (LLM_*).

# Model under test. Confirm exact ids with: make models
LLM_NAME=swiss-ai/Apertus-v1.5-8B
# Primary: CSCS (sovereign Swiss cloud). Key from the Hack Apertus email.
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=

# Fallback endpoint: Public AI. Requires a User-Agent header on every call.
PUBLICAI_BASE_URL=https://api.publicai.co/v1
PUBLICAI_API_KEY=
VIPUNEN_USER_AGENT=vipunen/0.1 (Hack Apertus 2026)

# Hugging Face: only for gated weights (self-hosted vLLM) or dataset upload.
HF_TOKEN=

# Spend ceiling in USD. Budget gate fails closed when exceeded.
VIPUNEN_BUDGET_USD=5

# --- Optional ---------------------------------------------------------------
# llm (default: LLM_* above) | publicai (PUBLICAI_* fallback; also serves v1.0 instruct models)
# VIPUNEN_ENDPOINT=llm
# Model for the llm stages (verse, escalation). Default: same as LLM_NAME.
# VIPUNEN_STAGE_MODEL=swiss-ai/Apertus-v1.5-8B
# Target sampling. Default temperature 0 and a fixed seed for reproducible probes.
# VIPUNEN_TEMPERATURE=0
# VIPUNEN_SEED=1234
# Set to 1 to stop all calls (same as creating var/KILL).
# VIPUNEN_KILL=0
